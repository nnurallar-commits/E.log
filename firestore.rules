rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function own(uid){ return signedIn() && request.auth.uid == uid; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function pairId(){ return userDoc().data.pairId; }

    match /users/{uid} {
      allow read, write: if own(uid);

      match /devices/{deviceId} {
        allow read, create, update, delete: if own(uid);
      }
    }

    match /pairs/{pair}/{document=**} {
      allow read, write: if signedIn() && pairId() == pair;
    }
  }
}
